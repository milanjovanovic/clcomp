(in-package :clcomp)

(define-vop fixnump (res :register :stack) ((arg :register :stack))
  (let ((false-label (make-vop-label "true"))
	(exit-label (make-vop-label "exit")))
    (inst :mov *tmp-reg* arg)
    (inst :test *tmp-reg* *fixnum-mask*)
    (inst :jump-fixup :jnz false-label)
    (inst :mov res *t*)
    (inst :jump-fixup :jmp exit-label)
    (inst :label false-label)
    (inst :mov res *nil*)
    (inst :label exit-label)))

(define-vop two-args-+ (res :register :stack) ((arg1 :register :stack)
					       (arg2 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :add *tmp-reg* arg2)
  (inst :mov res *tmp-reg*))

(define-vop two-args-- (res :register :stack) ((arg1 :register :stack)
					       (arg2 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :sub *tmp-reg* arg2)
  (inst :mov res *tmp-reg*))

(define-vop two-args-> (res :register :stack) ((arg1 :register :stack)
					       (arg2 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :mov res *t*)
  (inst :cmp *tmp-reg* arg2)
  (inst :mov *tmp-reg* *nil*)
  (inst :cmovle res *tmp-reg*))

(define-vop two-args-< (res :register :stack) ((arg1 :register :stack)
					       (arg2 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :mov res *t*)
  (inst :cmp *tmp-reg* arg2)
  (inst :mov *tmp-reg* *nil*)
  (inst :cmovge res *tmp-reg*))

(define-vop two-args-= (res :register :stack) ((arg1 :register :stack)
					       (arg2 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :mov res *t*)
  (inst :xor *tmp-reg* arg2)
  (inst :mov *tmp-reg* *nil*)
  (inst :cmovnz res *tmp-reg*))

(define-vop two-args->= (res :register :stack) ((arg1 :register :stack)
						(arg2 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :mov res *t*)
  (inst :cmp *tmp-reg* arg2)
  (inst :mov *tmp-reg* *nil*)
  (inst :cmovl res *tmp-reg*))

(define-vop two-args-<= (res :register :stack) ((arg1 :register :stack)
						(arg2 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :mov res *t*)
  (inst :cmp *tmp-reg* arg2)
  (inst :mov *tmp-reg* *nil*)
  (inst :cmovg res *tmp-reg*))

(define-vop abs (res :register :stack) ((arg1 :register))
  (inst :mov *tmp-reg* arg1)
  (inst :sar *tmp-reg* *fixnum-tag-size*)
  (inst :sar *tmp-reg* (- (* *word-size* 8) 1))
  (inst :mov res arg1)
  (inst :xor res *tmp-reg*)
  (inst :sub res *tmp-reg*))

(define-vop %neg (res :register :stack) ((arg1 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :neg *tmp-reg*)
  (inst :mov res *tmp-reg*))

(define-vop two-args-logxor (res :register :stack) ((arg1 :register :stack)
						    (arg2 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :xor *tmp-reg* arg2)
  (inst :mov res *tmp-reg*))

(define-vop two-args-logand (res :register :stack) ((arg1 :register :stack)
						    (arg2 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :and *tmp-reg* arg2)
  (inst :mov res *tmp-reg*))

(define-vop two-args-logior (res :register :stack) ((arg1 :register :stack)
						    (arg2 :register :stack))
  (inst :mov *tmp-reg* arg1)
  (inst :or *tmp-reg* arg2)
  (inst :mov res *tmp-reg*))

(define-vop %fixnum->fixnum-shift-left (res :register) ((arg1 :register) (arg2 :register))
  (inst :mov *tmp-reg* :RCX)
  (inst :mov res arg1)
  (inst :mov :RCX arg2)
  (inst :shr :RCX *fixnum-tag-size*)
  (inst :shl res :CL)
  (inst :mov :RCX *tmp-reg*))

(define-vop %fixnum-shift-right (res :register) ((arg1 :register) (arg2 :register))
  (inst :mov *tmp-reg* :RCX)
  (inst :mov res arg1)
  (inst :mov :RCX arg2)
  (inst :shr :RCX *fixnum-tag-size*)
  (inst :sar res :CL)
  (inst :and res (ash -1 *fixnum-tag-size*))
  (inst :mov :RCX *tmp-reg*))

(define-vop %fixnum-evenp (res :register :stack) ((arg :register :stack))
  (inst :mov res *t*)
  (inst :mov *tmp-reg* arg)
  (inst :test arg (ash 1 *fixnum-tag-size*))
  (inst :mov *tmp-reg* *nil*)
  (inst :cmovnz res *tmp-reg*))

;; FIXME
(define-vop %imul (res :register) ((arg1 :register) (arg2 :register :stack))
  (inst :mov res arg1)
  (inst :sar res *fixnum-tag-size*)
  (inst :mov *tmp-reg* arg2)
  (inst :sar *tmp-reg* *fixnum-tag-size*)
  (inst :imul res arg2)
  (inst :shl res *fixnum-tag-size*))



;;; FIXME, 
(define-vop %fixnum-fixnum-remainder (res :register) ((arg1 :register :stack) (arg2 :register))
  (inst :push :rax)
  (inst :push :rdx)
  (inst :mov :rax arg1)
  (inst :cqo)
  (inst :idiv :rax arg2)
  (inst :mov res :rdx)
  (inst :pop :rdx)
  (inst :pop :rax))

(define-vop %fixnum-fixnum-quotient (res :register) ((arg1 :register :stack) (arg2 :register))
  (inst :push :rax)
  (inst :push :rdx)
  (inst :mov :rax arg1)
  (inst :cqo)
  (inst :idiv :rax arg2)
  (inst :mov res :rax)
  (inst :shl res *fixnum-tag-size*)
  (inst :pop :rdx)
  (inst :pop :rax))
